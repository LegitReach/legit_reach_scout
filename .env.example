JINA_API_KEY=
APIFY_PROXY_USERNAME=
APIFY_PROXY_PASSWORD=
WAITLIST_WEBHOOK_URL=
MOCK_MODE=false

# LegitBot release controls. Integrations default off in application code.
LEGITBOT_ENABLED=false
LEGITBOT_ADMIN_ENABLED=false
LEGITBOT_BILLING_ENABLED=false
LEGITBOT_DATA_API_ENABLED=false
LEGITBOT_INGESTION_ENABLED=false
LEGITBOT_MATCHING_ENABLED=false
LEGITBOT_EMAIL_INTROS_ENABLED=false
LEGITBOT_ALERTS_ENABLED=false
LEGITBOT_X_AUTOMATION_ENABLED=false
LEGITBOT_X_CONCIERGE_MODE=true
LEGITBOT_PUBLIC_POSTING_ENABLED=false
LEGITBOT_ANALYTICS_ENABLED=false
LEGITBOT_EMERGENCY_DISABLE=false

# LegitBot server-only security. Use independent, high-entropy production values.
# FIELD_ENCRYPTION_KEY is an app-level 32-byte key encoded as base64.
LEGITBOT_FIELD_ENCRYPTION_KEY=
LEGITBOT_API_KEY_PEPPER=
LEGITBOT_OWNER_X_USER_ID=
LEGITBOT_OWNER_X_USERNAME=ManthanAdmane23
LEGITBOT_OWNER_CLERK_USER_IDS=
LEGITBOT_ACCOUNT_X_USER_ID=
